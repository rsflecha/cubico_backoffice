# Copia este ficheiro para .env e preenche. O .env nunca vai para o Git.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cubico
DB_USER=root
DB_PASS=
APP_DEBUG=true
# Segredo para assinar os tokens de sessão. Gera um com:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Os sites que podem usar a API (a versão web da app), separados por vírgulas.
# No PC:       http://localhost:*
# No servidor: https://app.fazendasubmersa.pt
CORS_ORIGINS=http://localhost:*
