# Copia este ficheiro para .env e preenche. O .env nunca vai para o Git.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cubico
DB_USER=root
DB_PASS=
APP_DEBUG=true
# Segredo para assinar os tokens de sessão. Gera um com:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Os sites que podem usar a API (a versão web da app), separados por vírgulas.
# No PC:       http://localhost:*
# No servidor: https://app.fazendasubmersa.pt
CORS_ORIGINS=http://localhost:*
# A app da Etsy (etsy.com/developers → a tua app). Nunca no Git.
# O x-api-key da Etsy leva os dois: keystring:shared_secret.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Tem de ser IGUAL ao callback URL registado na Etsy (só https).
ETSY_REDIRECT_URI=https://api.fazendasubmersa.pt/api/etsy/callback
